{
  "name": "@li-nk.me/node-sdk",
  "version": "0.2.14",
  "type": "module",
  "description": "Official li-nk.me Node.js client for administering links via the Edge API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/r-dev-limited/li-nk.me-node-sdk"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-cjs",
    "README.md",
    "LICENSE",
    "!dist/**/*.test.*",
    "!dist-cjs/**/*.test.*"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.cjs",
    "clean": "rimraf dist dist-cjs",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "keywords": [
    "li-nk",
    "linkme",
    "universal-links",
    "deeplinks",
    "sdk",
    "node"
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "ts-mockito": "^2.6.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
